{
  "name": "@doola/loader",
  "version": "0.0.0",
  "private": true,
  "description": "The loader served from js.doola.com. Public source, never published to npm.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsup src/index.ts --format iife --target es2020 --clean --out-dir dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "@doola/js": "workspace:*",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
