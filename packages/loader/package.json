{
  "name": "@doola/loader",
  "version": "0.0.0",
  "private": true,
  "description": "The loader served from js.doola.com. Public source, never published to npm.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsup src/index.ts --format iife --minify --target es2020 --clean --out-dir dist",
    "test": "vitest run && pnpm run test:browser",
    "test:browser": "pnpm --filter @doola/js build && pnpm run build && playwright test"
  },
  "devDependencies": {
    "@doola/js": "workspace:*",
    "@doola/sdk-protocol": "workspace:*",
    "@playwright/test": "^1.63.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
