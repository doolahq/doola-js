{
  "name": "@doola/sdk-protocol",
  "version": "0.1.0",
  "description": "Internal to doola: the wire format between doola's SDK loader and embedded app. Partners use @doola/js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/doolahq/doola-js.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/doolahq/doola-js/tree/main/packages/protocol#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "api:check": "api-extractor run",
    "api:update": "pnpm run build && api-extractor run --local"
  },
  "devDependencies": {
    "@doola/js": "workspace:*",
    "@microsoft/api-extractor": "^7.59.2",
    "@types/node": "^22",
    "esbuild": "^0.28.1",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
