{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Confined to the test program: the tests read docs/protocol.md and bundle
    // the package to measure it, so they need Node's types — src must not.
    "types": ["node"],
    // Same reason as packages/loader/tsconfig.test.json, which carries it in
    // full: vitest's bundled .d.ts chain does not compile under the base.
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
