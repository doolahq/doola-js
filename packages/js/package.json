{
  "name": "@doola/js",
  "version": "0.1.0",
  "description": "Loader and TypeScript types for embedding doola formation in your product.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/doolahq/doola-js.git",
    "directory": "packages/js"
  },
  "type": "module",
  "types": "./src/index.ts",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm,cjs --dts --target es2020 --clean"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsup": "^8.3.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  }
}
