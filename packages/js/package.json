{
  "name": "@doola/js",
  "version": "0.1.2",
  "description": "Loader, TypeScript types and a server session helper for embedding doola formation in your product.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/doolahq/doola-js.git",
    "directory": "packages/js"
  },
  "homepage": "https://github.com/doolahq/doola-js/tree/main/packages/js#readme",
  "keywords": [
    "doola",
    "sdk",
    "embedded",
    "company-formation",
    "llc",
    "c-corp",
    "ein",
    "iframe",
    "white-label"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsup src/index.ts src/server.ts --format esm,cjs --dts --target es2020 --clean",
    "test": "vitest run",
    "api:check": "api-extractor run && api-extractor run -c api-extractor.server.json",
    "api:update": "pnpm run build && api-extractor run --local && api-extractor run --local -c api-extractor.server.json"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.2",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typesVersions": {
      "*": {
        "server": [
          "./dist/server.d.ts"
        ]
      }
    },
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./server": {
        "import": {
          "types": "./dist/server.d.ts",
          "default": "./dist/server.js"
        },
        "require": {
          "types": "./dist/server.d.cts",
          "default": "./dist/server.cjs"
        }
      }
    }
  }
}
