{
  "name": "@doola/js",
  "version": "0.1.3",
  "description": "Loader and TypeScript types for embedding doola formation in your product.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/doolahq/doola-js.git",
    "directory": "packages/js"
  },
  "homepage": "https://github.com/doolahq/doola-js/tree/main/packages/js#readme",
  "keywords": [
    "doola",
    "sdk",
    "embedded",
    "company-formation",
    "llc",
    "c-corp",
    "ein",
    "iframe",
    "white-label"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm,cjs --dts --target es2020 --clean",
    "api:check": "api-extractor run",
    "api:update": "pnpm run build && api-extractor run --local"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.2",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  }
}
